// Build settings every developer sets for their own copy of Helix.
// Do not edit this file: copy Helix.local.xcconfig.example to Helix.local.xcconfig (gitignored) and set your values there.

// Your Apple Developer Team ID (developer.apple.com > Membership). Push, VoIP calls and Siri need a paid account.
DEVELOPMENT_TEAM =

// Your bundle ID. The Siri extension is $(HELIX_BUNDLE_ID).Intents, and the VoIP push topic is $(HELIX_BUNDLE_ID).voip.
// The gateway's HELIX_APNS_BUNDLE_ID must match it exactly.
HELIX_BUNDLE_ID = com.example.helix

// Optional: your gateway's Tailscale Serve host name (for example my-pc.my-tailnet.ts.net, without https://).
// It is pre-filled in the pairing sheet; leave it empty to type it on the phone.
HELIX_GATEWAY_HOST =

// CarPlay needs an entitlement that Apple grants per developer (see docs/CARPLAY.md). Without it, Xcode refuses to sign
// the app, so the default leaves CarPlay out. Once Apple approves yours, use Helix/Config/Helix-CarPlay.entitlements.
// A free (personal) team cannot use push, VoIP or Siri: use Helix/Config/Helix-Free.entitlements.
HELIX_APP_ENTITLEMENTS = Helix/Config/Helix.entitlements

#include? "Helix.local.xcconfig"
