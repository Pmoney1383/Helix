# Copy to .env and adjust. Never commit .env. Commented-out lines show the default (or an example) and can stay commented.
# Full setup: docs/SETUP.md.

# --- Server ---------------------------------------------------------------------------------------------------------
# Keep the gateway on loopback and expose it to your tailnet with `tailscale serve` (gives TLS).
HELIX_HOST=127.0.0.1
HELIX_PORT=7777
HELIX_DATA_DIR=./data
HELIX_LOG_LEVEL=info

# --- Claude Code ----------------------------------------------------------------------------------------------------
HELIX_CLAUDE_BIN=claude
# default = Claude asks for permission as usual and every prompt is answered by Helix's approval gate.
HELIX_CLAUDE_PERMISSION_MODE=default
# Default working directory for new sessions that don't specify a projectPath
# HELIX_DEFAULT_PROJECT=C:\Users\you\Documents\Projects
# Minutes before an unanswered approval counts as rejected (fails closed)
# HELIX_APPROVAL_TTL_MIN=30
# Heavy-session guard: a message to a session over this many tokens whose prompt cache went cold (after this many
# seconds idle) is refused until confirmed, because it would re-read the whole context.
# HELIX_HEAVY_SESSION_TOKENS=150000
# HELIX_CACHE_COLD_SEC=270

# --- Codex (optional; offered only if the CLI is installed) --------------------------------------------------------
# HELIX_CODEX_ENABLED=true
# Full path if `codex` is not on the service's PATH
# HELIX_CODEX_BIN=C:\Users\you\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe
# workspace-write (default) confines Codex to the project; danger-full-access makes "approve" mean "done"
# HELIX_CODEX_SANDBOX=workspace-write
# untrusted (default) makes Codex ask about anything not known-safe; on-request/never weaken the approval gate
# HELIX_CODEX_APPROVAL=untrusted

# --- Session discovery ----------------------------------------------------------------------------------------------
# Index every Claude Code / Codex session on this machine
# HELIX_DISCOVERY=true
# HELIX_CLAUDE_HOME=C:\Users\you\.claude
# HELIX_CODEX_HOME=C:\Users\you\.codex

# --- Presence -------------------------------------------------------------------------------------------------------
# Minutes without keyboard/mouse input before you count as away (phone alerts are only sent while away)
# HELIX_PRESENCE_AWAY_MIN=5

# --- Apple push: notifications and calls (docs/PUSH-SETUP.md) --------------------------------------------------------
# Set all four or none. Keep the .p8 OUTSIDE any git repository. The bundle ID must match the app's HELIX_BUNDLE_ID.
# HELIX_APNS_KEY_PATH=C:\keys\AuthKey_XXXXXXXXXX.p8
# HELIX_APNS_KEY_ID=XXXXXXXXXX
# HELIX_APNS_TEAM_ID=YYYYYYYYYY
# HELIX_APNS_BUNDLE_ID=com.example.helix
# Seconds a call rings before it becomes a missed call
# HELIX_RING_TIMEOUT_SEC=30
# Minutes an approval waits after its push before the phone rings (0 = never call)
# HELIX_APPROVAL_CALL_AFTER_MIN=5

# --- Hosted ChatGPT / claude.ai access (docs/HOSTED.md) -------------------------------------------------------------
# Your public Funnel URL; used to print connector URLs and enables the Funnel watchdog
# HELIX_PUBLIC_URL=https://my-pc.my-tailnet.ts.net
# HELIX_FUNNEL_WATCHDOG=true
# HELIX_TAILSCALE_BIN=C:\Program Files\Tailscale\tailscale.exe
# Desktop control: irreversible-looking desktop actions (Delete key, destructive typed commands, actions the model marks
# irreversible) wait for your approval. false skips that approval; for testing only.
# HELIX_DESKTOP_APPROVALS=true
# Live desktop viewer (pc-gateway/docs/COMPUTER-USE.md) uses direct WebRTC + STUN by default. Configure your own TURN
# relay for restrictive networks. Credentials are delivered only to the authorized viewer, never in model content.
# HELIX_VIEWER_CARDS=false
# HELIX_VIEWER_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:relay.example:3478","username":"viewer","credential":"replace-me"}]

# --- Device security ------------------------------------------------------------------------------------------------
# Devices must sign every request with a key held on the phone (docs/DEVICE-SIGNING.md). On by default; the apps enroll
# a key when they pair. Set false only to use a client that cannot sign, such as the `npm run client` test CLI.
# HELIX_REQUIRE_DEVICE_SIGNING=true
# Hosted connectors may only return to these hosts after sign-in (subdomains included; loopback is always allowed).
# Add a host for another MCP client, or use * to allow any https host.
# HELIX_OAUTH_REDIRECT_HOSTS=chatgpt.com,claude.ai,claude.com

# --- Local PC voice (optional, bring your own model: docs/LOCAL-TTS.md) ---------------------------------------------
# OFF unless HELIX_TTS_ENABLED=true. Even when on, it starts only when a call or spoken turn needs it, stops itself after
# HELIX_TTS_IDLE_SEC without a request, and refuses to start while the GPU or RAM is busy (for example while a model is
# training), so it never competes with other GPU work.
# HELIX_TTS_ENABLED=false
# Engine: chatterbox | qwen3 | qwen3stream (WSL2) | fake (tests)
# HELIX_TTS_ENGINE=qwen3
# HELIX_TTS_PYTHON=C:\helix-tts\venv\Scripts\python.exe
# chatterbox: a ~10 s reference clip of a voice you have the right to use
# HELIX_TTS_REFERENCE=C:\helix-tts\my_voice.wav
# qwen3: workspace with models\Qwen3-TTS-12Hz-1.7B-Base and ref\ref.json
# HELIX_TTS_QWEN_ROOT=C:\helix-tts\qwen
# qwen3stream runs inside WSL2 (Linux paths)
# HELIX_TTS_WSL_DISTRO=Ubuntu
# HELIX_TTS_WSL_PYTHON=/home/you/helix-tts/venv/bin/python
# HELIX_TTS_WSL_QWEN_ROOT=/home/you/helix-tts/qwen
# Where model downloads are cached (sets HF_HOME for the voice process)
# HELIX_TTS_HF_HOME=C:\helix-tts\hf
# Pre-recorded canned lines (`npm run voice -- clips`)
# HELIX_TTS_CLIPS_DIR=C:\helix-tts\clips
# HELIX_TTS_PORT=7791
# HELIX_TTS_IDLE_SEC=180
# HELIX_TTS_MIN_FREE_VRAM_MB=6000
# HELIX_TTS_MIN_FREE_RAM_MB=4000
# Keep the voice loaded while you are away from the PC and the GPU is free
# HELIX_TTS_WARM_WHEN_AWAY=true
# Longest the first audio of a spoken reply is held so the rest plays without gaps (0 = no holding; non-streaming engines)
# HELIX_TTS_SMOOTH_HOLD_SEC=12
